{
  "name": "profitpulse-mobile",
  "version": "2.0.0",
  "description": "ProfitPulse — E-Commerce Profit Tracker Native Android App (Capacitor)",
  "main": "www/index.html",
  "scripts": {
    "cap:init": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "cap:open": "npx cap open android",
    "icons": "npx capacitor-assets generate --android",
    "apk:debug": "npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0"
  },
  "author": "ProfitPulse",
  "license": "MIT"
}
